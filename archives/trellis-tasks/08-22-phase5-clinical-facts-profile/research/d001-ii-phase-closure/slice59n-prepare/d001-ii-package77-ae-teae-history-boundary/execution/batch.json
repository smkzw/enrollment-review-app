      "priority_rank": 0,
      "schema_version": "phase5/v1",
      "source_order": 27900,
      "source_ref": "body.p1024",
      "source_span_ids": [
        "body.p1024"
      ],
      "structure_unit_id": "su-125f9fa39aa720039d48020e",
      "study_phase": "phase_ii",
      "table_context": null,
      "unit_kind": "paragraph"
    },
    {
      "excerpt": "不良事件的记录与规定",
      "heading_path": [
        "研究评估和程序",
        "安全性评估",
        "不良事件的收集和记录",
        "不良事件的记录与规定"
