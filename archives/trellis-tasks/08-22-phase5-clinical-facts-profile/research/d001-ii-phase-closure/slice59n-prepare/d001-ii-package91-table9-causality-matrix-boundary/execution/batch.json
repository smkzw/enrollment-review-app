        "body.p1088"
      ],
      "structure_unit_id": "su-5aaf226dcc02b5a3e08dd903",
      "study_phase": "phase_ii",
      "table_context": null,
      "unit_kind": "paragraph"
    },
    {
      "excerpt": "研究者需根据五个评价要点进行临床试验个例不良事件与试验用药品相关性综合评价，并提供相关性判定依据。五个评价要点概括如下：",
      "heading_path": [
        "研究评估和程序",
        "安全性评估",
        "不良事件的评估",
        "不良事件因果关系判断"
      ],
      "is_footnote_or_note": false,
      "member_source_refs": [
        "body.p1089"
      ],
      "phase_scopes": [
        "unknown"
      ],
      "priority_keyword_hits": [],
      "priority_rank": 0,
      "schema_version": "phase5/v1",
