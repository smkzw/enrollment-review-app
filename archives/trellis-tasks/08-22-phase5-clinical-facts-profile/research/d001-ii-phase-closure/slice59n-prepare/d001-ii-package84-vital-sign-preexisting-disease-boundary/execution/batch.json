  "context_units": [
    {
      "excerpt": "不良事件于D1启动给药后开始记录，直至末次安全性随访或者退出研究为止（以先发生时间为准）。",
      "heading_path": [
        "方案摘要",
        "研究流程表"
      ],
      "is_footnote_or_note": false,
      "member_source_refs": [
