    "unit_kind": "paragraph"
  },
  {
    "excerpt": "Ⅱ期为探索性研究，不做检验假设。",
    "heading_path": [
      "统计学考虑",
      "统计假设"
    ],
    "lookup": "frozen_plan_context",
    "package_id": "pap-fb5d1edc8f1ed99baf4a4a8a",
    "package_ordinal": 100,
    "role": "attached",
