  "context_units": [
    {
      "excerpt": "Ⅱ期为探索性研究，不做检验假设。",
      "heading_path": [
        "统计学考虑",
        "统计假设"
      ],
      "is_footnote_or_note": false,
      "member_source_refs": [
        "body.p1171"
      ],
      "phase_scopes": [
        "phase_ii"
      ],
      "priority_keyword_hits": [],
