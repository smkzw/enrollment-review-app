    ],
    "structure_unit_id": "su-b8f50ce08241665176f77a21",
    "unit_kind": "list_item"
  },
  {
    "excerpt": "丙型肝炎（Hepatitis C Virus，HCV）抗体阳性，且HCV-RNA拷贝数阳性（定义为超过研究中心检测值正常范围上限）；",
    "heading_path": [
      "研究人群",
      "排除标准"
    ],
    "lookup": "frozen_plan_owned",
