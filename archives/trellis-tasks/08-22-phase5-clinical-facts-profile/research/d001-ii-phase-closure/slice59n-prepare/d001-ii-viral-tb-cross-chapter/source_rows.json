    "unit_kind": "list_item"
  },
  {
    "excerpt": "胸部CT提示当前或既往活动性结核感染；",
    "heading_path": [
      "研究人群",
      "排除标准"
    ],
    "lookup": "frozen_plan_owned",
    "package_id": "pap-172e5937fb9973123d54aa19",
