    "unit_kind": "list_item"
  },
  {
    "excerpt": "人类免疫缺陷病毒抗体（Hepatitis C Virus Ribonucleic Acid，HIV Ab）阳性；",
    "heading_path": [
      "研究人群",
      "排除标准"
    ],
    "lookup": "frozen_plan_owned",
