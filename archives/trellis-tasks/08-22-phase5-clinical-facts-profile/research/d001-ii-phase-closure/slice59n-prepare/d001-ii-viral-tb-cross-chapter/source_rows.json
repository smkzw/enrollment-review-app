    "unit_kind": "list_item"
  },
  {
    "excerpt": "在筛选期间，研究者判断存在活动性结核病的体征或症状；",
    "heading_path": [
      "研究人群",
      "排除标准"
    ],
    "lookup": "frozen_plan_owned",
    "package_id": "pap-172e5937fb9973123d54aa19",
