    "unit_kind": "list_item"
  },
  {
    "excerpt": "结核检测：筛选期进行γ干扰素释放试验（即QFT或T-SPOT试验）。",
    "heading_path": [
      "方案摘要",
      "研究流程表"
    ],
    "lookup": "frozen_plan_context",
