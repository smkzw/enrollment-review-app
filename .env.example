# ============================================================
# 临床试验入排审核系统 — 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# Ollama Cloud：在本工作树的 .env 中填写 OLLAMA_API_KEY（见下方“其他方案控制 Agent”）。
# 可使用 OMP 中同一 Ollama Cloud 密钥；本产品不会自动读取 OMP 的凭据库。
# 不要将真实密钥写入本示例文件或提交到 Git。

# --- 服务器 ---
HOST=127.0.0.1
PORT=8900

# --- 显式环境文件契约（worktree / 专用 V2 强烈建议）---
# 启动前导出绝对路径，例如：
#   export ENROLLMENT_ENV_FILE="/path/to/enrollment-review-app/.env"
# 进程会以 setdefault 加载该文件；已在 shell 中导出的变量优先。
# 未设置时回退读取本仓库根目录 .env（若存在）。
# ENROLLMENT_ENV_FILE=
# Existing evaluated method approval; empty keeps formal publication unavailable.
# This reference does not create or bypass approval.
ENROLLMENT_REVIEW_METHOD_APPROVAL_GATE_ID=
# 方案语义路由启动预检：1=启用（默认），0=跳过。
# ENROLLMENT_SEMANTIC_ROUTE_PREFLIGHT=1
# degrade=声明候选不可用时显式降级（默认）；strict=任一声明候选不可用即拒绝启动。
# ENROLLMENT_SEMANTIC_ROUTE_PREFLIGHT_MODE=degrade
# 端点 TCP 预检默认启用；测试必须显式关闭或注入故障探测器。
# ENROLLMENT_SEMANTIC_ENDPOINT_PREFLIGHT=1

# --- oMLX 本地模型服务 ---
# 默认自动读取 macOS oMLX 的 config.json；只有需要手动指定时才取消下行注释。
# OMLX_BASE_URL=http://127.0.0.1:8001
OMLX_API_KEY=not-needed

# --- MTPLX 本地语义模型服务（OpenAI 兼容）---
# 两套完整主读均由本产品直接调用，串行加载；没有手写第三读。
# MTPLX 调用必须显式提供产品模型清单的绝对路径；缺少时拒绝读取。
# executable 必须使用原生 CLI，不使用会额外唤起 GUI 的启动包装脚本。
# 清单字段：version=1、executable、base_url（含/v1）、log_directory、
# max_tokens=131072、models=[{model, path, effort}]，所有文件路径为绝对路径。
# ENROLLMENT_MTPLX_MODELS_FILE=
MTPLX_BASE_URL=http://127.0.0.1:8002
MTPLX_API_KEY=not-needed
MTPLX_MODEL=Youssofal--Qwen3.8-Flash-Next-MTPLX-Optimized-Speed
MTPLX_REASONING_EFFORT=xhigh

# --- 历史 OCR 路径配置（新上传原件直接由双 VLM 阅读，不调用此路径）---
# 支持的后端: omlx | minimax
OCR_BACKEND=omlx
# 长文档模型（>= OCR_LONG_PAGE_THRESHOLD 页）
OCR_MODEL_LONG=models--PaddlePaddle--PaddleOCR-VL-1.6
# 短文档模型（< OCR_LONG_PAGE_THRESHOLD 页）
OCR_MODEL_SHORT=models--PaddlePaddle--PaddleOCR-VL-1.6
# 长文档阈值（页数）
OCR_LONG_PAGE_THRESHOLD=5
# 渲染 DPI（100 足够 OCR，速度更快）
OCR_DPI=180
# 并发 OCR 数
OCR_MAX_CONCURRENT=8

# --- 产品自有模型连接（各角色可独立选择，不借用个人 harness）---
CMS_ROUTER_BASE_URL=http://127.0.0.1:20128/v1
CMS_ROUTER_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=

# --- 审核模型（入排判断）---
REVIEW_BACKEND=opencode-go
REVIEW_MODEL=deepseek-v4.1-flash
REVIEW_REASONING_EFFORT=high

# --- 方案解构模型（提取入排标准）---
# 支持的后端包括 cms-router、opencode-go 及兼容的历史连接。
# DECONSTRUCT_BACKEND/MODEL 保留为 pinned 单针或兼容导入默认值。
DECONSTRUCT_BACKEND=cms-router
DECONSTRUCT_MODEL=glm-5.3-flash
MTPLX_PROTOCOL_BATCH_MAX_TOKENS=131072
OMLX_PROTOCOL_BATCH_MAX_TOKENS=131072
DECONSTRUCT_MAX_TOKENS=65536
DECONSTRUCT_REASONING_EFFORT=high
# graded = 任务分级显式回退；pinned = 仅使用上方单针，不做跨供应商链式回退。
DECONSTRUCT_ROUTE_MODE=pinned
DECONSTRUCT_SHORT_PROMPT_MAX_INPUT_TOKENS=4096
# 可选覆盖：backend:model:effort 逗号分隔；仅 graded 模式使用。
# 未配置时复杂与短任务均使用 GLM high，不隐式引入第三模型。
# DECONSTRUCT_ROUTE_COMPLEX=
# DECONSTRUCT_ROUTE_SHORT=
# 方案语义 GLM 独立配置。密钥留空时复用下方 INDEPENDENT_VLM_API_KEY；
# 只有需要使用不同智谱账户时才单独填写 DECONSTRUCT_GLM_API_KEY。
DECONSTRUCT_GLM_PROVIDER=cms-router
DECONSTRUCT_GLM_BASE_URL=http://127.0.0.1:20128/v1
# DECONSTRUCT_GLM_API_KEY=
DECONSTRUCT_GLM_MODEL=glm-5.3-flash
DECONSTRUCT_GLM_REASONING_EFFORT=high
# 旧方案解构备用模型设置不参与当前双路线；不在示例中指定旧网关模型。
# 超大官方父规则：项目无关结构分段 + 有限并发 + 同父确定性合并。
# 仅当结构规划器能产出 >=2 个可并行安全分段时启用；令牌大小本身不会强制不安全切割。
# 默认并发 2，硬上限 3。
DECONSTRUCT_PARENT_SEGMENTATION_ENABLED=true
DECONSTRUCT_PARENT_SEGMENT_MAX_CONCURRENCY=2
DECONSTRUCT_PARENT_SEGMENT_SOFT_INPUT_TOKENS=8000
DECONSTRUCT_PARENT_SEGMENT_MIN_SOURCE_SPANS=4
DECONSTRUCT_PARENT_SEGMENT_MIN_OBLIGATIONS=3
DECONSTRUCT_PARENT_SEGMENT_SOFT_TOKENS=3500
DECONSTRUCT_PARENT_SEGMENT_MAX_UNITS_PER_SEGMENT=3

# --- 证据规范化与期别语义 ---
EVIDENCE_NORMALIZER_PROVIDER=ollama-cloud
EVIDENCE_NORMALIZER_MODEL=deepseek-v4.1-flash
EVIDENCE_NORMALIZER_MAX_TOKENS=65536
EVIDENCE_NORMALIZER_MAX_PAGES_PER_CALL=2
# 留空时使用模型服务的默认采样参数
EVIDENCE_NORMALIZER_TEMPERATURE=
EVIDENCE_NORMALIZER_REASONING_EFFORT=high
# GLM 默认直连端点；推理强度仅支持 low/high/max。
# 凭据只从本项目显式 env 合同获取，不读取 Hermes、OMP 或其他 harness。
#EVIDENCE_NORMALIZER_GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
#EVIDENCE_NORMALIZER_GLM_API_KEY=
#EVIDENCE_NORMALIZER_GLM_MODEL=glm-5.3-flash
#EVIDENCE_NORMALIZER_GLM_REASONING_EFFORT=high

# --- 其他方案控制 Agent（独立于官方 IN/EX 解构 Schema）---
# 发现与深审只使用 Ollama 专用凭据，不能沿用原 CMS 角色密钥。
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=
PROTOCOL_CONTROL_BACKEND=ollama-cloud
PROTOCOL_CONTROL_MODEL=deepseek-v4.1-flash
PROTOCOL_CONTROL_REASONING_EFFORT=high
PROTOCOL_CONTROL_MAX_TOKENS=65536
PROTOCOL_CONTROL_DISCOVERY_BACKEND=ollama-cloud
PROTOCOL_CONTROL_DISCOVERY_MODEL=deepseek-v4.1-flash
# 发现阶段：按输入令牌/输出预算自适应分包 + 有限并发（避免固定包串行回放）
PROTOCOL_CONTROL_ADAPTIVE_BATCHING=true
PROTOCOL_CONTROL_DISCOVERY_MAX_INPUT_TOKENS=16000
PROTOCOL_CONTROL_DISCOVERY_MAX_OUTPUT_TOKENS=65536
PROTOCOL_CONTROL_DISCOVERY_OUTPUT_TOKENS_PER_UNIT=280
PROTOCOL_CONTROL_DISCOVERY_TEMPLATE_OVERHEAD_TOKENS=3500
PROTOCOL_CONTROL_DISCOVERY_CHARS_PER_TOKEN=1.2
PROTOCOL_CONTROL_DISCOVERY_ADAPTIVE_UNIT_CAP=24
# Independent discovery steps only; freeze into the durable job payload at create.
# 1 = serial (legacy). Do not mix with paused fixed-serial discovery jobs.
PROTOCOL_CONTROL_DISCOVERY_MAX_PARALLEL=1

# --- DeepSeek API（远程备用）---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# --- 历史选择性视觉补读配置（不是当前双主读）---
# 用于直接阅读方案、病历和检查资料的原始页面；语义审核仍按各任务独立路由。
INDEPENDENT_VLM_PROVIDER=cms-router
# 产品自身直接连接 cms-router 节点，不调用 OmniRouter/OMP harness。
INDEPENDENT_VLM_BASE_URL=http://127.0.0.1:20128/v1
INDEPENDENT_VLM_API_KEY=
INDEPENDENT_VLM_MODEL=glm-5.3-flash
INDEPENDENT_VLM_REASONING_EFFORT=high
INDEPENDENT_VLM_MAX_TOKENS=65536
INDEPENDENT_VLM_TIMEOUT_SECONDS=900
# Selective vision: native text first; only page-risk pages call Independent VLM.
SELECTIVE_VISION_ENABLED=false
SELECTIVE_VISION_OCR_CONFIDENCE_THRESHOLD=0.80
SELECTIVE_VISION_MAX_PAGES_PER_CALL=1

# --- Phase 5.5 受试者证据逐页判读 ---
# 两个完整主读道分别直连自己的端点；不通过个人 harness 转发。
PAGE_REVIEW_MAIN_A_PROVIDER=cms-router
PAGE_REVIEW_MAIN_A_BASE_URL=http://127.0.0.1:20128/v1
# PAGE_REVIEW_MAIN_A_API_KEY=
PAGE_REVIEW_MAIN_A_MODEL=glm-5.3-flash
PAGE_REVIEW_MAIN_A_REASONING_EFFORT=high
# 同模型备用端点可选；留空时端点失败会明确进入待复读，不静默换模型。
# PAGE_REVIEW_MAIN_A_FALLBACK_BASE_URL=
PAGE_REVIEW_MAIN_B_PROVIDER=ollama-cloud
PAGE_REVIEW_MAIN_B_BASE_URL=https://ollama.com/v1
# PAGE_REVIEW_MAIN_B_API_KEY 不用于 Ollama；仅使用 OLLAMA_API_KEY。
PAGE_REVIEW_MAIN_B_MODEL=deepseek-v4.1-flash
PAGE_REVIEW_MAIN_B_REASONING_EFFORT=high
# PAGE_REVIEW_MAIN_B_FALLBACK_BASE_URL=
PAGE_REVIEW_MAX_TOKENS=65536
PAGE_REVIEW_CLOUD_CONCURRENCY=3
PAGE_REVIEW_TIMEOUT_SECONDS=900

# --- MiniMax M3（可选远程 OCR）---
MINIMAX_BASE_URL=https://mimimax.cn/v1
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3

# --- 百度 OCR（手写文字增强，可选）---
BAIDU_OCR_APP_ID=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# --- 上传限制 ---
MAX_UPLOAD_SIZE=104857600
