# ============================================================
# 临床试验入排审核系统 — 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# --- 服务器 ---
HOST=127.0.0.1
PORT=8900

# --- oMLX 本地模型服务 ---
OMLX_BASE_URL=http://127.0.0.1:8000
OMLX_API_KEY=not-needed

# --- OCR 模型配置 ---
# 支持的后端: omlx | minimax
OCR_BACKEND=omlx
# 长文档模型（>= OCR_LONG_PAGE_THRESHOLD 页）
OCR_MODEL_LONG=models--PaddlePaddle--PaddleOCR-VL-1.6
# 短文档模型（< OCR_LONG_PAGE_THRESHOLD 页）
OCR_MODEL_SHORT=models--PaddlePaddle--PaddleOCR-VL-1.6
# 长文档阈值（页数）
OCR_LONG_PAGE_THRESHOLD=5
# 渲染 DPI（100 足够 OCR，速度更快）
OCR_DPI=180
# 并发 OCR 数
OCR_MAX_CONCURRENT=8

# --- 审核模型（入排判断）---
# 支持的后端: omlx | deepseek
REVIEW_BACKEND=omlx
REVIEW_MODEL=Qwen3.6-27B-oQ8-mtp
# DeepSeek V4审核思考强度: default | high | max
# default 表示不显式传 reasoning_effort，适合 deepseek-v4-flash 的高速低成本批量审核；
# 若使用 deepseek-v4-pro 做疑难复核，可改为 high；max 仅建议少量疑难病例人工复核前对照。
REVIEW_REASONING_EFFORT=default

# --- 方案解构模型（提取入排标准）---
# 支持的后端: omlx | deepseek（默认跟随 REVIEW_BACKEND）
# DECONSTRUCT_BACKEND=deepseek
# DECONSTRUCT_MODEL=deepseek-v4-pro

# --- DeepSeek API（远程备用）---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# --- MiniMax M3（可选远程 OCR）---
MINIMAX_BASE_URL=https://mimimax.cn/v1
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3

# --- 百度 OCR（手写文字增强，可选）---
BAIDU_OCR_APP_ID=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# --- 上传限制 ---
MAX_UPLOAD_SIZE=104857600
