  },
  {
    "excerpt": "药物不良反应（ADR）",
    "heading_path": [
      "研究评估和程序",
      "安全性评估",
      "术语定义",
      "药物不良反应（ADR）"
    ],
    "lookup": "frozen_plan_owned",
    "package_id": "pap-bb9bf95c9cd13f15e3b737f3",
    "package_ordinal": 80,
