      "table_context": null,
      "unit_kind": "list_item"
    },
    {
      "excerpt": "未好转/未缓解/持续：指不良事件在报告时仍未减轻或缓解。",
      "heading_path": [
        "研究评估和程序",
        "安全性评估",
        "不良事件的随访"
      ],
      "is_footnote_or_note": false,
