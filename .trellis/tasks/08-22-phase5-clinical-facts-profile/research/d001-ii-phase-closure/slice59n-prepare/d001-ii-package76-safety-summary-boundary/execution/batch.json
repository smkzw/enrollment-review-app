      "study_phase": "phase_ii",
      "table_context": null,
      "unit_kind": "paragraph"
    },
    {
      "excerpt": "可疑且非预期严重不良反应（SUSAR）",
      "heading_path": [
        "研究评估和程序",
        "安全性评估",
        "术语定义",
        "可疑且非预期严重不良反应（SUSAR）"
