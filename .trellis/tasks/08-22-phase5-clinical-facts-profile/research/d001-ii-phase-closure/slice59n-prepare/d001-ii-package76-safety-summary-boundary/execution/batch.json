        "body.p1017"
      ],
      "structure_unit_id": "su-f59a09007b7f5f516b7d01eb",
      "study_phase": "phase_ii",
      "table_context": null,
      "unit_kind": "paragraph"
    },
    {
      "excerpt": "可疑且非预期严重不良反应（Suspected Unexpected Serious Adverse Reaction，SUSAR）指临床表现的性质和严重程度超出了试验药物《研究者手册》、已上市药品的说明书或者产品特性摘要等已有资料信息的可疑并且非预期的严重不良反应。",
      "heading_path": [
        "研究评估和程序",
        "安全性评估",
        "术语定义",
        "可疑且非预期严重不良反应（SUSAR）"
      ],
      "is_footnote_or_note": false,
      "member_source_refs": [
        "body.p1018"
      ],
      "phase_scopes": [
        "unknown"
