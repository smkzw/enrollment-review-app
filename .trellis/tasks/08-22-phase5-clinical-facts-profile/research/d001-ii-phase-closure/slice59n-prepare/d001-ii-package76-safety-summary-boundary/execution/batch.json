    {
      "excerpt": "不良事件（AE）",
      "heading_path": [
        "研究评估和程序",
        "安全性评估",
        "术语定义",
        "不良事件（AE）"
      ],
      "is_footnote_or_note": false,
      "member_source_refs": [
        "body.p985"
      ],
      "phase_scopes": [
        "unknown"
      ],
      "priority_keyword_hits": [],
      "priority_rank": 0,
      "schema_version": "phase5/v1",
