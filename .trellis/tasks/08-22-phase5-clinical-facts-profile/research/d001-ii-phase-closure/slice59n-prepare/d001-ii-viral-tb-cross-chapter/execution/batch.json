        "span-e55345e2ccdd449e1986b83cf9b50701"
      ]
    },
    {
      "catalog_item_id": "pcm-row-759cd0638a6a427a10a3bceb",
      "label": "乙肝、丙肝、HIV及梅毒感染筛查",
      "official_code": "EX-22",
      "position": 28,
      "schema_version": "phase5/v1",
      "source_excerpts": [
        "梅毒特异性抗体试验阳性（梅毒非特异性抗体结果为阴性，并经研究者判断为过去曾感染梅毒但已治愈的参与者除外）；",
        "人类免疫缺陷病毒抗体（Hepatitis C Virus Ribonucleic Acid，HIV Ab）阳性；",
        "丙型肝炎（Hepatitis C Virus，HCV）抗体阳性，且HCV-RNA拷贝数阳性（定义为超过研究中心检测值正常范围上限）；",
        "乙型肝炎：表面抗原（Hepatitis B surface antigen，HBsAg）阳性，或核心抗体（Hepatitis B surface antibody，HBcAb）阳性且乙型肝炎病毒脱氧核糖核酸（Hepatitis B virus Deoxyribonucleic acid，HBV-DNA）拷贝数阳性（定义为超过研究中心检测值正常范围上限）；",
        "筛选访视时存在下列任一感染者："
      ],
