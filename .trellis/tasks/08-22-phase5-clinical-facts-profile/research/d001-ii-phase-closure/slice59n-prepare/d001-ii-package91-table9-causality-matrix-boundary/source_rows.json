    "source_span_ids": [
      "body.p1088"
    ],
    "structure_unit_id": "su-5aaf226dcc02b5a3e08dd903",
    "unit_kind": "paragraph"
  },
  {
    "excerpt": "研究者需根据五个评价要点进行临床试验个例不良事件与试验用药品相关性综合评价，并提供相关性判定依据。五个评价要点概括如下：",
    "heading_path": [
      "研究评估和程序",
      "安全性评估",
      "不良事件的评估",
      "不良事件因果关系判断"
    ],
    "lookup": "frozen_plan_owned",
    "package_id": "pap-969cb2554a2487b656fbbb20",
    "package_ordinal": 90,
    "role": "attached",
