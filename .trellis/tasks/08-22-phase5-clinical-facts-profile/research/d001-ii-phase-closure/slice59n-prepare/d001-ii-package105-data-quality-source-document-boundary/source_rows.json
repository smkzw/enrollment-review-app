  {
    "excerpt": "数据质量保证",
    "heading_path": [
      "数据采集与管理",
      "数据质量保证"
    ],
    "lookup": "frozen_plan_owned",
    "package_id": "pap-b8d5cdfbc6ac4c373c6576b3",
