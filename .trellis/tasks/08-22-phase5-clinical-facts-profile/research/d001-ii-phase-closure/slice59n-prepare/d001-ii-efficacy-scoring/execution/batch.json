        "body.p825"
      ],
      "structure_unit_id": "su-baddf307128adae6b6fc9908",
      "study_phase": "phase_ii",
      "table_context": null,
      "unit_kind": "paragraph"
    },
    {
      "excerpt": "皮肤病学生活质量指数（DLQI）",
      "heading_path": [
        "研究评估和程序",
        "研究期间的检查和评估",
        "疗效评价"
      ],
      "is_footnote_or_note": false,
      "member_source_refs": [
        "body.p826"
      ],
      "phase_scopes": [
        "unknown"
      ],
      "priority_keyword_hits": [],
