{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase5_acceptance_ledger/v1",
  "title": "Phase 5 Acceptance Ledger",
  "description": "Machine-readable case-level ledger for P5-AC01..P5-AC13. Automated test green is never sufficient for overall pass when clinical_manual or browser_tester evidence is required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case",
    "criteria",
    "overall"
  ],
  "properties": {
    "schema_version": {
      "const": "phase5_acceptance_ledger/v1"
    },
    "case": {
      "$ref": "#/$defs/CaseIdentity"
    },
    "criteria": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/CriterionRecord"
      }
    },
    "overall": {
      "$ref": "#/$defs/OverallRecord"
    }
  },
  "$defs": {
    "EvidenceClass": {
      "type": "string",
      "enum": [
        "deterministic",
        "clinical_manual",
        "browser_tester",
        "conference_advisory"
      ]
    },
    "Disposition": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "blocked",
        "not_run",
        "observed_only",
        "advisory"
      ],
      "description": "pass/fail are judgments; observed_only records facts without claiming clinical correctness; advisory is conference-only and cannot substitute tester or clinical_manual."
    },
    "CaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "project_label",
        "subject_label",
        "isolation_root",
        "fabricated"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ledger case id (not a clinical conclusion)."
        },
        "project_label": {
          "type": "string",
          "description": "Human label such as D001-II or MG-K10-SAR-III; empty until Codex assigns an isolated copy."
        },
        "subject_label": {
          "type": "string",
          "description": "Subject label inside the isolated project; empty until assigned."
        },
        "isolation_root": {
          "type": "string",
          "description": "Workspace-relative path to the isolated project copy; empty until prepared."
        },
        "database_path": {
          "type": ["string", "null"],
          "description": "Optional SQLite path for structural case checks."
        },
        "project_id": {
          "type": ["string", "null"]
        },
        "subject_id": {
          "type": ["string", "null"]
        },
        "review_episode_id": {
          "type": ["string", "null"]
        },
        "fabricated": {
          "type": "boolean",
          "const": false,
          "description": "Must remain false; ledger builders must not invent real-case clinical entries."
        }
      }
    },
    "EvidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_class",
        "source_locator",
        "artifact",
        "observed_result",
        "verifier",
        "timestamp",
        "disposition"
      ],
      "properties": {
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "source_locator": {
          "type": "string",
          "minLength": 1,
          "description": "DB row id, file path, EvidenceLocator id, screenshot path, or conference report path."
        },
        "artifact": {
          "type": "string",
          "minLength": 1,
          "description": "Concrete artifact that can be reopened (test log, screenshot, note, SQL dump pointer)."
        },
        "observed_result": {
          "type": "string",
          "minLength": 1,
          "description": "What was observed. Must not encode an enrollment decision."
        },
        "verifier": {
          "type": "string",
          "minLength": 1,
          "description": "Who or what verified: pytest node id, Codex, named tester route, conference role."
        },
        "timestamp": {
          "type": "string",
          "minLength": 1,
          "description": "ISO-8601 timestamp of the observation."
        },
        "disposition": {
          "$ref": "#/$defs/Disposition"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "CriterionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "title",
        "required_evidence_classes",
        "evidence",
        "criterion_disposition",
        "blocking_reasons"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "pattern": "^P5-AC(0[1-9]|1[0-3])$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "required_evidence_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/EvidenceClass"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          }
        },
        "criterion_disposition": {
          "$ref": "#/$defs/Disposition"
        },
        "blocking_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "OverallRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "deterministic_all_green",
        "clinical_manual_complete",
        "browser_tester_complete",
        "conference_advisory_present",
        "blocking_reasons",
        "evaluated_at"
      ],
      "properties": {
        "disposition": {
          "$ref": "#/$defs/Disposition"
        },
        "deterministic_all_green": {
          "type": "boolean",
          "description": "True when every required deterministic evidence item is pass. Never alone sufficient for overall pass."
        },
        "clinical_manual_complete": {
          "type": "boolean"
        },
        "browser_tester_complete": {
          "type": "boolean"
        },
        "conference_advisory_present": {
          "type": "boolean",
          "description": "Advisory presence for P5-AC13; cannot replace browser_tester or clinical_manual."
        },
        "blocking_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evaluated_at": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
